' Gambas class file

Private $rData As Result
Private $aMyFields As String[]

Public Sub Form_Open()

  cmbcategory.List = modNonMedical.BillServiceCategory()
  cmbplanA.List = modNonMedical.FillCashModeCombo()
  cmbplanB.List = modNonMedical.FillCashModeCombo()

End

Public Sub Form_KeyRelease()

  modGeneralmain.GoToNextControlTab()

End

Public Sub btnshow_Click()

  If cmbcategory.Text Then
    FillGroupGrid(cmbcategory.Text)
  Endif

End

Private Sub FillGroupGrid(xCateg As String)

  $rData = modDatabase.$myConn.Exec("select fldid,fldbillingmode,flditemname,fldtobillingmode,fldtoitemname from tblservicemap where fldcategory=&1", xCateg)
  $aMyFields = New String[]
  modGridView.ReadSmallData(GridView1, $rData, $aMyFields)

  With GridView1
    .Columns[0].Width = 1
    .Columns[1].Width = 125 * modBasic.$AppWidthRatio
    .Columns[2].Width = 250 * modBasic.$AppWidthRatio
    .Columns[3].Width = 125 * modBasic.$AppWidthRatio
    .Columns[4].Width = 250 * modBasic.$AppWidthRatio

    .Columns[1].Text = "RatePlan"
    .Columns[2].Text = "Particulars"
    .Columns[3].Text = "RatePlan"
    .Columns[4].Text = "Particulars"
  End With

End

Public Sub GridView1_Data(Row As Integer, Column As Integer)

  $rData.MoveTo(Row)
  modGeneralMain.GridViewDecoration(GridView1, Row)
  GridView1.Data.Text = $rData[$aMyFields[Column]]

End

Public Sub cmbcategory_KeyRelease()

  modFillContainer.AutoFillComboBox(cmbcategory)
  modFillContainer.RestrictComboToContent(cmbcategory)

End

Public Sub cmbplanA_KeyRelease()

  modFillContainer.AutoFillComboBox(cmbplanA)
  modFillContainer.RestrictComboToContent(cmbplanA)

End

Public Sub cmbplanB_KeyRelease()

  modFillContainer.AutoFillComboBox(cmbplanB)
  modFillContainer.RestrictComboToContent(cmbplanB)

End

Public Sub cmbitemA_GotFocus()

  Dim xLst As String[]

  If Not cmbitemA.Text Then
    If cmbplanA.Text And If cmbcategory.Text Then
      xLst = modNonMedical.NonStockBillActiveItemArray(cmbcategory.Text, cmbplanA.Text)
      If xLst.Count Then
        cmbitemA.Text = GridViewNew("Select Particulars", xLst, False, cmbitemA)
      Endif
    Endif
  Endif

End

Public Sub cmbItemB_GotFocus()

  Dim xLst As String[]

  If Not cmbItemB.Text Then
    If cmbplanB.Text And If cmbcategory.Text Then
      xLst = modNonMedical.NonStockBillActiveItemArray(cmbcategory.Text, cmbplanB.Text)
      If xLst.Count Then
        cmbItemB.Text = GridViewNew("Select Particulars", xLst, False, cmbItemB)
      Endif
    Endif
  Endif

End

Public Sub btnadd_Click()

  Dim res As Result

  If modNonMedical.GetControlServCombo(cmbitemA.Text) = False Then
    cmbitemA.Text = ""
    cmbitemA.SetFocus
  Else If modNonMedical.GetControlServCombo(cmbItemB.Text) = False Then
    cmbItemB.Text = ""
    cmbItemB.SetFocus
  Else
    If cmbcategory.Text And If cmbitemA.Text And If cmbItemB.Text Then
      res = modDatabase.$myConn.Create("tblservicemap")
      res["fldcategory"] = cmbcategory.Text
      res["fldbillingmode"] = cmbplanA.Text
      res["flditemname"] = cmbitemA.Text
      res["fldtobillingmode"] = cmbplanB.Text
      res["fldtoitemname"] = cmbItemB.Text
      res["flduserid"] = modBasic.$lbluser
      res["fldtime"] = Now()
      res["fldcomp"] = modBasic.$compID
      res["fldsave"] = True
      res["flduptime"] = ""
      res.Update
      FillGroupGrid(cmbcategory.Text)

      Balloon.Info(("Information saved"), btnadd)
      Balloon.Delay = modBasic.$BalloonDelay
      cmbitemA.Text = ""
      cmbItemB.Text = ""
      cmbitemA.SetFocus
    Endif

  Endif

End

Public Sub GridView1_Menu()

  mnuhide.Popup

End

Public Sub mnudelete_Click()

  If GridView1.Rows.Selection.Count Then
    modDatabase.$myConn.Delete("tblservicemap", "fldid=&1", GridView1[GridView1.Row, 0].Text)
    FillGroupGrid(cmbcategory.Text)
  Endif

End
