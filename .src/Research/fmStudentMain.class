Public Sub btnshowmenu_Click()

  Dim res As Result
  Dim res1 As Result
  Dim xList As String[]

  If txtstudycode.Text Then
    res = modDatabase.$myConn.Exec("select fldformname,fldstatus from tblstudentaccess where flduserid=&1 and fldstudycode=&2", modBasic.$lbluser, txtstudycode.Text)
    If res.Available Then
      SetMenuActive(True)
      xList = New String[]
      For Each res
        If res["fldstatus"] = "Inactive" Then
          xList.Add(res["fldformname"])
        Endif
      Next
      modGeneralMain.$HideFormList = xList
      res1 = modDatabase.$myConn.Exec("select fldstudystart,fldstudyend from tblresearch where fldstudycode=&1", txtstudycode.Text)
      If res1.Available Then
        modResearch.$dtStart = res1["fldstudystart"]
        modResearch.$dtEnd = res1["fldstudyend"]
      Endif

    Else
      SetMenuActive(False)
    Endif
  Endif

End

Private Sub SetMenuActive(sBool As Boolean)

  mnurepo.Enabled = sBool
  mnuservreport.Enabled = sBool
  mnuclinical.Enabled = sBool
  mnudiagno.Enabled = sBool
  mnuqueryall.Enabled = sBool
  mnucustreport.Enabled = sBool

End
