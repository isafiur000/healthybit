' Gambas class file

Private $encid As String
Private $sType As String

Public Sub _new(encid As String, sType As String)

  $encid = encid
  $sType = sType

End

Public Sub Form_Open()

  ShowProgressParams()

End

Public Sub RefreshProgress()

  ShowProgressParams()

End

Private Sub ShowProgressParams()

  Dim sql As String
  Dim res As Result

  sql = "select fldid,fldtime,fldid,fldproblem,fldsubjective,fldobjective,fldassess,fldplan from tblpatplanning where fldencounterval=&1 and fldplancategory=&2 ORDER BY fldtime DESC"
  res = modDatabase.$myConn.Exec(sql, $encid, $sType)
  If res.Available Then
    res.MoveFirst
    TabPanel1.Enabled = True
    txtmonvalue.Value = res["fldid"]
    txtmonimpression.Text = res["fldproblem"]
    txtmonproblem.RichText = res["fldsubjective"]
    txtmontreatment.RichText = res["fldobjective"]
    txtmoninout.RichText = res["fldassess"]
    txtmonplan.RichText = res["fldplan"]
  Else
    TabPanel1.Enabled = False
  Endif

End

Public Sub dctprogproblem_Click()

  Dim xx As String

  xx = GetRichTextArea("Problem Summary", txtmonproblem.RichText)
  If xx Then
    txtmonproblem.RichText = xx
  Endif

End

Public Sub btntemplpprogproblem_Click()

  txtmonproblem.RichText = txtmonproblem.RichText & DictionaryVIew("Problem Summary")

End

Public Sub dctprogtreat_Click()

  Dim xx As String

  xx = GetRichTextArea("Treatment Summary", txtmontreatment.RichText)
  If xx Then
    txtmontreatment.RichText = xx
  Endif

End

Public Sub btntemplprogtreat_Click()

  txtmontreatment.RichText = txtmontreatment.RichText & DictionaryVIew("Treatment Summary")

End

Public Sub dctproginout_Click()

  Dim xx As String

  xx = GetRichTextArea("Intake/Output Summary", txtmoninout.RichText)
  If xx Then
    txtmoninout.RichText = xx
