    AutoResize = True
    Alignment = Align.Normal
  }
  { Panel1 Panel
    MoveScaled(1,6,47,13)
    { txtinfuse ValueBox
      MoveScaled(19,1,14,3)
    }
    { txtdiscard ValueBox
      MoveScaled(19,5,14,3)
    }
    { btnsave Button
      MoveScaled(19,9,14,3)
      Tag = "Auto"
      Text = ("Save")
      Picture = Picture["icon:/small/apply"]
    }
    { Label3 Label
      MoveScaled(0,5,18,3)
      Border = Border.Plain
      Text = ("Volume Discarded")
    }
    { Label2 Label
      MoveScaled(0,1,18,3)
      Border = Border.Plain
      Text = ("Volumen Infused")
    }
    { Label1 Label
      MoveScaled(34,1,6,3)
      Alignment = Align.Center
      Text = ("mL")
    }
    { Label4 Label
      MoveScaled(34,5,6,3)
      Alignment = Align.Center
      Text = ("mL")
    }
  }
}
