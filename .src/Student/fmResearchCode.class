' Gambas class file

Private $rData As Result
Private $aMyFields As String[]

Public Sub Form_Open()

  modGeneralMain.ArrangeEmbedForms(Me, Panel1, "Vertical")
  Me.Icon = Picture[modGeneralMain.$strLogo]
  dtstart.Value = Now()
  dtend.Value = Now()
  cmbstatus.List = ["Planned", "Running", "Cancelled", "Completed"]
  ShowStudyGrid()

End

Public Sub Form_Close()

  modGeneralMain.RecordFormExit(Me)

End

Public Sub Form_Resize()

  modGeneralMain.ShowSelectedFormMenu(Me)

End

Public Sub Form_KeyRelease()

  If Key.Code = Key.Esc Then
    Me.Close
  Else
    modGeneralmain.GoToNextControlTab()
  Endif

End

Public Sub txtircform_Click()

  If Dialog.OpenFile() Then Return
  txtircform.Text = Dialog.Path

End

Public Sub txtconsentform_Click()

  If Dialog.OpenFile() Then Return
  txtconsentform.Text = Dialog.Path

End

Public Sub txtinterviewform_Click()

  If Dialog.OpenFile() Then Return
  txtinterviewform.Text = Dialog.Path

End

Public Sub btnBrOK_Click()

  Dim res As Result

  If txtstudycode.Text Then
    res = modDatabase.$myConn.Create("tblresearch")
    res["fldstudycode"] = txtstudycode.Text
    res["fldstudyname"] = txtstudyname.Text
    res["fldstudylocat"] = txtinvestigator.Text
    ' res["fldsamplesize"] = txtsample.Value
    res["fldstudystart"] = dtstart.Value
    res["fldstudyend"] = dtend.Value
    res["fldstudysample"] = txtdescription.RichText
    ' res["fldstudycriteria"] = txtsqltext.Text
    If modMisc.BlobTarget("ResearchImages") = "FTP" Then
      If txtircform.Text Then
        res["fldircconsentpic"] = ""
        res["fldircconsentlink"] = modFTPSub.SendBlobToFTP(txtircform.Text, modBasic.$lbluser, "ResearchImages")
      Endif
      If txtconsentform.Text Then
        res["fldconsentformpic"] = ""
        res["fldconsentformlink"] = modFTPSub.SendBlobToFTP(txtconsentform.Text, modBasic.$lbluser, "ResearchImages")
      Endif
      If txtinterviewform.Text Then
        res["fldiintervireformpic"] = ""
        res["fldinterviewformlink"] = modFTPSub.SendBlobToFTP(txtinterviewform.Text, modBasic.$lbluser, "ResearchImages")
      Endif
    Else
      If txtircform.Text Then
        res["fldircconsentpic"] = File.Load(txtircform.Text)
        res["fldircconsentlink"] = ""
      Endif
      If txtconsentform.Text Then
        res["fldconsentformpic"] = File.Load(txtconsentform.Text)
        res["fldconsentformlink"] = ""
      Endif
      If txtinterviewform.Text Then
        res["fldiintervireformpic"] = File.Load(txtinterviewform.Text)
        res["fldinterviewformlink"] = ""
      Endif
    Endif
    res["fldstatus"] = cmbstatus.Text
    res.Update()
    ShowStudyGrid()
    Balloon.Info(("Information saved"), btnBrOK)
    Balloon.Delay = modBasic.$BalloonDelay
  Endif

End

Private Sub ShowStudyGrid()

  $rData = modDatabase.$myConn.Exec("select fldstudycode,fldstudyname,fldstudylocat,fldsamplesize,fldstudystart,fldstudyend,fldstatus from tblresearch")
  $aMyFields = New String[]
  modGridView.ReadSmallData(GridView1, $rData, $aMyFields)
  With GridView1
    .Columns[0].Width = 100 * modBasic.$AppWidthRatio
    .Columns[1].Width = 300 * modBasic.$AppWidthRatio
    .Columns[2].Width = 150 * modBasic.$AppWidthRatio
    .Columns[3].Width = 1
    .Columns[4].Width = 100 * modBasic.$AppWidthRatio
    .Columns[5].Width = 100 * modBasic.$AppWidthRatio
    .Columns[6].Width = 75 * modBasic.$AppWidthRatio

    .Columns[0].Text = "StudyCode"
    .Columns[1].Text = "Title of Study"
    .Columns[2].Text = "Investigator"
    .Columns[4].Text = "Start"
    .Columns[5].Text = "End"
    .Columns[6].Text = "Status"
  End With

End

Public Sub GridView1_Data(Row As Integer, Column As Integer)

  $rData.MoveTo(Row)
  modGeneralMain.GridViewDecoration(GridView1, Row)
  If Column = 4 Then
    GridView1.Data.Text = modReportVar.GetDateTimeReport($rData[$aMyFields[Column]], gb.MediumDate)
  Else If Column = 5 Then
    GridView1.Data.Text = modReportVar.GetDateTimeReport($rData[$aMyFields[Column]], gb.MediumDate)
  Else
    GridView1.Data.Text = $rData[$aMyFields[Column]]
  Endif

End

Public Sub btnedit_Click()

  Dim res As Result

  If txtstudycode.Text Then
    res = modDatabase.$myConn.Edit("tblresearch", "fldstudycode=&1", txtstudycode.Text)
    res["fldstudyname"] = txtstudyname.Text
    res["fldstudylocat"] = txtinvestigator.Text
    ' res["fldsamplesize"] = txtsample.Value
    res["fldstudystart"] = dtstart.Value
    res["fldstudyend"] = dtend.Value
    res["fldstudysample"] = txtdescription.RichText
    ' res["fldstudycriteria"] = txtsqltext.Text
    If modMisc.BlobTarget("ResearchImages") = "FTP" Then
      If txtircform.Text Then
        res["fldircconsentpic"] = ""
        res["fldircconsentlink"] = modFTPSub.SendBlobToFTP(txtircform.Text, modBasic.$lbluser, "ResearchImages")
      Endif
      If txtconsentform.Text Then
        res["fldconsentformpic"] = ""
        res["fldconsentformlink"] = modFTPSub.SendBlobToFTP(txtconsentform.Text, modBasic.$lbluser, "ResearchImages")
      Endif
      If txtinterviewform.Text Then
        res["fldiintervireformpic"] = ""
        res["fldinterviewformlink"] = modFTPSub.SendBlobToFTP(txtinterviewform.Text, modBasic.$lbluser, "ResearchImages")
      Endif
    Else
      If txtircform.Text Then
        res["fldircconsentpic"] = File.Load(txtircform.Text)
        res["fldircconsentlink"] = ""
      Endif
      If txtconsentform.Text Then
        res["fldconsentformpic"] = File.Load(txtconsentform.Text)
        res["fldconsentformlink"] = ""
      Endif
      If txtinterviewform.Text Then
        res["fldiintervireformpic"] = File.Load(txtinterviewform.Text)
        res["fldinterviewformlink"] = ""
      Endif
    Endif
    res["fldstatus"] = cmbstatus.Text
    res.Update()
    ShowStudyGrid()
    Balloon.Info(("Information saved"), btnedit)
    Balloon.Delay = modBasic.$BalloonDelay
  Endif

End

Public Sub GridView1_Click()

  Dim res As Result

  res = modDatabase.$myConn.Exec("select fldstudycode,fldstudyname,fldstudylocat,fldsamplesize,fldstudystart,fldstudyend,fldstudysample,fldstudycriteria,fldircconsentlink,fldconsentformlink,fldinterviewformlink,fldstatus from tblresearch where fldstudycode=&1", GridView1[GridView1.Row, 0].Text)                                                             ''
  If res.Available Then
    txtstudycode.Text = res["fldstudycode"]
    txtstudyname.Text = res["fldstudyname"]
    txtinvestigator.Text = res["fldstudylocat"]
    ' txtsample.Value = res["fldsamplesize"]
    dtstart.Value = res["fldstudystart"]
    dtend.Value = res["fldstudyend"]
    txtdescription.RichText = res["fldstudysample"]
    ' txtsqltext.Text = res["fldstudycriteria"]
    cmbstatus.Text = res["fldstatus"]

    If res["fldircconsentlink"] Then
      txtircform.Text = res["fldircconsentlink"]
    Endif
    If res["fldconsentformlink"] Then
      txtconsentform.Text = res["fldconsentformlink"]
    Endif
    If res["fldinterviewformlink"] Then
      txtinterviewform.Text = res["fldinterviewformlink"]
    Endif

  Endif

End

Public Sub txtstudycode_KeyPress()

  modGeneralMain.InputTextKeyOnly()

End

Public Sub btncreateuser_Click()

  fmStudent.Close
  fmStudent.ShowModal

End

Public Sub GridView1_Menu()

  mnuhide.Popup

End

Public Sub mnuaccess_Click()

  Dim hForm As FmStudentAccess

  If GridView1.Rows.Selection.Count Then
    hForm = New FmStudentAccess(GridView1[GridView1.Row, 0].Text)
    hForm.ShowModal
  Endif

End
