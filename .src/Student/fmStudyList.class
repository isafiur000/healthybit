' Gambas class file

Private $txtStudy As TextBox
Private $rData As Result
Private $aMyFields As String[]

Public Sub _new(txtstudy As TextBox)

  $txtStudy = txtstudy

End

Public Sub Form_Open()

  ShowStudyList()

End

Private Sub ShowStudyList()

  $rData = modDatabase.$myConn.Exec("select fldstudycode,fldstudyname,fldstudylocat,fldsamplesize,fldstudystart,fldstudyend,fldstatus from tblresearch where fldstudycode in(select fldstudycode from tblstudentaccess where flduserid=&1)", modBasic.$lbluser)
  $aMyFields = New String[]
  modGridView.ReadSmallData(GridView1, $rData, $aMyFields)

  With GridView1
    .Columns[0].Width = 125 * modBasic.$AppWidthRatio
    .Columns[1].Width = 400 * modBasic.$AppWidthRatio
    .Columns[2].Width = 200 * modBasic.$AppWidthRatio
    .Columns[3].Width = 1
    .Columns[4].Width = 125 * modBasic.$AppWidthRatio
    .Columns[5].Width = 125 * modBasic.$AppWidthRatio
    .Columns[6].Width = 100 * modBasic.$AppWidthRatio

    .Columns[0].Text = "StudyCode"
    .Columns[1].Text = "Title of Study"
    .Columns[2].Text = "Investigator"
    .Columns[4].Text = "Start"
    .Columns[5].Text = "End"
    .Columns[6].Text = "Status"
  End With

End

Public Sub GridView1_Data(Row As Integer, Column As Integer)

  $rData.MoveTo(Row)
  modGeneralMain.GridViewDecoration(GridView1, Row)
  If Column = 4 Then
    GridView1.Data.Text = modReportVar.GetDateTimeReport($rData[$aMyFields[Column]], gb.MediumDate)
  Else If Column = 5 Then
    GridView1.Data.Text = modReportVar.GetDateTimeReport($rData[$aMyFields[Column]], gb.MediumDate)
  Else
    GridView1.Data.Text = $rData[$aMyFields[Column]]
  Endif

End

Public Sub GridView1_Click()

  $txtStudy.Text = GridView1[GridView1.Row, 0].Text

End
