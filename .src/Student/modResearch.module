' Gambas module file

Public $dtStart As Date
Public $dtEnd As Date

Public Sub GetResearchSettings(dtfir As DateBox, dtlast As DateBox)

  modBasic.$PatNameFormat = "Encrypted"
  dtfir.Value = $dtStart
  dtfir.Enabled = False
  dtlast.Value = $dtEnd
  dtlast.Enabled = False

End

Public Function GetStudyTitle(studycode As String) As String

  Dim res As Result
  Dim xx As String

  res = modDatabase.$medConn.Exec("select fldstudyname from tblresearch where fldstudycode=&1", studycode)
  If res.Available Then
    If res["fldstudyname"] Then
      xx = res["fldstudyname"]
    Else
      xx = ""
    Endif
  Else
    xx = ""
  Endif
  Return xx

End

