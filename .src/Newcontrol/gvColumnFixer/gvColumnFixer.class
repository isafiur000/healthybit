  gvData.ShowCursor = Value
  $Form.gvFijo.ShowCursor = Value

End

Private Function Header_Read() As Integer

  Return $Header

End

Private Sub Header_Write(Value As Integer)

  $Header = Value
  SetHeaders()

End

Public Sub SetHeaders()

  Select Case $Header
    Case GridView.Both
      If $Form.FixedColumns.count > 0 Then
        gvData.Header = GridView.Horizontal
        gvFixed.Header = GridView.Both
      Else
        gvData.Header = GridView.Both
        gvFixed.Header = GridView.None
      Endif
    Case GridView.Horizontal
      gvData.Header = GridView.Horizontal
      gvFixed.Header = GridView.Horizontal
    Case GridView.Vertical
      If $Form.FixedColumns.count > 0 Then
        gvData.Header = GridView.None
        gvFixed.Header = GridView.Vertical
      Else
        gvData.Header = GridView.Vertical
        gvFixed.Header = GridView.None
      Endif
    Case GridView.None
      gvData.Header = GridView.None
      gvFixed.Header = GridView.None
  End Select

End

