' Gambas class file

Inherits UserControl

Export

Public Const _Properties As String = "*,FixedColumns{},FixedForeground{Color},FixedBackground{Color},Grid=True,ShowCursor=False,Header{Gridview.*}=Both,ScrollBar{Scroll.*}=Both,Mode{Select.*}=Single,Padding{Range:0;63}=2"
Public Const _Group As String = "View"
Public Const _Similar As String = "GridView"
Public Const _DrawWith As String = "GridView"

Event Data(row As Integer, column As Integer)
Event Change
Event Select
Event Activate
Event Click
Event Scroll
Event Font

Property FixedColumns As Integer[]
Property FixedForeground As Integer
Property FixedBackground As Integer

Property ShowCursor As Boolean
Property Mode As Integer
Property Header As Integer
Property ScrollBar As Integer
Property Row As Integer
Property Column As Integer
Property Grid As Boolean
Property Padding As Integer
Property Font As Font

Property Read Rows As _Gridview_Rows
Property Read Columns As _Gridview_Columns
Property Read Current As _GridView_Cell
Property Read {Data} As _GridView_Data

Public gvData As Gridview
Public gvFixed As Gridview

Private $Form As FgvColFixer
Private $Header As Integer
Private $scrollBar As Integer

Public Sub _new()

  $Form = New FgvColFixer(Me)
  $Form.FixedColumns = New Integer[]
  $Form.FixedForeground = Color.Foreground
  gvFixed = $Form.gvFijo
  gvData = $Form.gvDatos
  gvData.Mode = Select.Single
  gvFixed.Mode = Select.Single
  $ScrollBar = Scroll.Both
  $Header = GridView.Both
  gvData.Grid = True
  gvFixed.Grid = True
  gvData.Padding = 2
  gvFixed.Padding = 2
  Me.proxy = gvData

End

Public Sub _get(Row As Integer, Column As Integer) As _Gridview_Cell

  Return gvData[row, column]

End

Public Sub _RaiseData(row As Integer, column As Integer)

  Dim n, i As Integer

  Raise Data(row, column)
  For n = 0 To $Form.gvFijo.Rows.Max
    For i = 0 To $Form.fixedcolumns.max
      $Form.gvfijo[n, i].text = gvData[n, $Form.FixedColumns[i]].Text
      $Form.gvfijo[n, i].Background = $Form.FixedBackground
      $Form.gvfijo[n, i].Foreground = $Form.FixedForeground
    Next
  Next

End

Public Sub _RaiseChange()

  Raise Change

End

Public Sub _RaiseSelect()

  Raise Select

End

Public Sub _RaiseActivate()

  Raise Activate

End

Public Sub _RaiseClick()

  Raise Click

End

Public Sub _RaiseScroll()

  Raise Scroll

End

Public Sub _RaiseFont()

  Raise Font

End

