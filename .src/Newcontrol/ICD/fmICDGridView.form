# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,75,60)
  Text = ("ICD Database")
  Arrangement = Arrange.Vertical
  Margin = True
  { Panel1 Panel
    MoveScaled(0,0,74,3.5)
    { txtname ButtonBox
      MoveScaled(4,0,27,3)
      ToolTip = ("Write few alphabets of disease name for quick sorting")
      Picture = Picture["icon:/small/cancel"]
    }
    { btnsemantic Button
      MoveScaled(31,0,4.5,3)
      Visible = False
      Picture = Picture["icon:/small/right"]
    }
    { btnok Button
      MoveScaled(42,0,13.375,3)
      Text = ("Save")
      Picture = Picture["icon:/small/save"]
    }
    { txtcode TextBox
      MoveScaled(58,0,15,3)
    }
    { chkleftmain CheckBox
      MoveScaled(1,0,3,3)
    }
  }
  { GridView1 GridView
    MoveScaled(1,5,73,50.625)
    Expand = True
    Mode = Select.Single
    Header = GridView.Horizontal
    AutoResize = False
  }
  { Panel2 Panel
    MoveScaled(0,56,73.875,3.5)
    { chkgroup CheckBox
      MoveScaled(32,0,14,3)
      Text = ("Group Only")
    }
    { chksemantic CheckBox
      MoveScaled(55,0,18,3)
      Text = ("Semantic Search")
    }
    { chkboth CheckBox
      MoveScaled(1,0,19,3)
      Text = ("Both Codings")
    }
  }
}
