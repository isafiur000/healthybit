# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,96,53)
  Text = ("Select Patient Reports")
  Resizable = False
  Arrangement = Arrange.Vertical
  Margin = True
  { mnufile Menu
    Text = ("File")
    { mnuscanfile Menu
      Text = ("Scan File")
      Shortcut = "Ctrl+W"
    }
    { mnucamera Menu
      Text = ("Camera")
    }
  }
  { mnudoreport Menu
    Text = ("Activity")
    { mnuopenfile Menu
      Text = ("Open File")
    }
    { mnuprint Menu
      Text = ("Print File")
    }
    { mnuemail Menu
      Text = ("E-Mail")
    }
    { mnuftp Menu
      Text = ("FTP Save")
    }
  }
  { mnudocs Menu
    { mnuopd Menu
      Text = ("Create Prescription")
    }
    { mnucreadmission Menu
      Text = ("Create Admission")
    }
    { mnudischarge Menu
      Text = ("Create Discharge")
    }
  }
  { Panel1 Panel
    MoveScaled(1,1,94,4)
    { btnupload Button
      MoveScaled(76,0.5,16,3)
      Text = ("Select")
      Picture = Picture["icon:/small/add"]
    }
    { cmbsource ComboBox
      MoveScaled(0,0.5,21,3)
    }
    { mnucreate MenuButton
      MoveScaled(52,0.5,22,3)
      Text = ("Generate")
    }
    { btnrefresh Button
      MoveScaled(24,0.5,13,3)
      Text = ("Show")
      Picture = Picture["icon:/small/refresh"]
    }
  }
  { GridView1 GridView
    MoveScaled(1,5,94,38)
    Expand = True
    Mode = Select.Single
    Header = GridView.Both
    AutoResize = False
  }
  { Panel2 Panel
    MoveScaled(1,44,94,4)
    { cmbfiscal ComboBox
      MoveScaled(0,0.5,16,3)
    }
    { Panel3 Panel
      MoveScaled(20,0.5,32,3)
      { chkcurrent RadioButton
        MoveScaled(1,0,16,3)
        Text = ("Current Visit")
        Value = True
      }
      { chklast RadioButton
        MoveScaled(18,0,12,3)
        Text = ("Last Visit")
      }
    }
  }
}
