# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,83,63)
  Resizable = False
  Arrangement = Arrange.Vertical
  Margin = True
  { Panel1 Panel
    MoveScaled(0,0,82,4)
    { btnrecord Button
      MoveScaled(0,0,16,3.5)
      Text = ("START")
    }
    { btnclose Button
      MoveScaled(65,0,16,3.5)
      Text = ("Save")
      Cancel = True
    }
    { LCDLabel1 LCDLabel
      MoveScaled(20,0,13,3.5)
      Text = ("00 : 00")
      Alignment = Align.Center
      Border = True
    }
    { Timer1 #Timer
      #MoveScaled(57,-1)
    }
    { buninstall ToolButton
      MoveScaled(41,0,3.5,3)
      Picture = Picture["icon:/small/exec"]
    }
  }
  { Panel2 Panel
    MoveScaled(0,4,82,11)
    { Label1 Label
      MoveScaled(0,3.5,10,3)
      Border = Border.Plain
      Text = ("Language")
    }
    { cmblanguage ComboBox
      MoveScaled(11,3.5,23,3)
    }
    { cmbmodel ComboBox
      MoveScaled(11,0,23,3)
    }
    { Label3 Label
      MoveScaled(0,0,10,3)
      Border = Border.Plain
      Text = ("Model")
    }
    { ListBox1 ListBox
      MoveScaled(41,0,40,10)
      Sorted = True
    }
    { Timer2 #Timer
      #MoveScaled(34,1)
      Delay = 5000
    }
    { Panel3 Panel
      MoveScaled(0,7,34,3)
      { btnstart Button
        MoveScaled(0,0,6,3)
        Picture = Picture["icon:/small/play"]
      }
      { btnstop Button
        MoveScaled(28,0,6,3)
        Picture = Picture["icon:/small/stop"]
      }
    }
  }
  { TextArea1 TextArea
    MoveScaled(0,17,81,35)
    Expand = True
    Wrap = True
  }
  { TerminalView1 TerminalView
    MoveScaled(0,53,82,9)
  }
}
