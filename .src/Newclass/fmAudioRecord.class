' Gambas class file

' Private $hProc As Process
Private $hProcess As Process
Private $sFolder As String

Private $hProc As Process
Private $sPath As String

Private $start As Date
Private $doneLst As String[]
Private $sValue As String

Private primesTask1 As Task
Private primesTask2 As Task
Private primesTask3 As Task
Private primesTask4 As Task
Private primesTask5 As Task
Private $Index As Integer

Public Sub Run() As String

  If Me.ShowModal() Then Return $sValue

End

Public Sub Form_Open()

  Me.Center
  $hProcess = TerminalView1.Shell("ipython3")
  If modBasic.$AudioRecMultiFiles = "Yes" Then
    ListBox1.Visible = True
    TerminalView1.Visible = True
  Else
    ListBox1.Visible = False
    TerminalView1.Visible = False
  Endif
  If modBasic.$CloudAIURL_Trans And If modBasic.$CloudAIModel_Trans Then
    cmbmodel.Enabled = False
    cmblanguage.Enabled = False
    cmbmodel.Text = modBasic.$CloudAIModel_Trans
  Else
    cmbmodel.Enabled = True
    cmblanguage.Enabled = True
    cmblanguage.List = ["English"]
    cmblanguage.Text = "English"
    cmbmodel.List = modMLModels.GetAIModelsList("voice-to-text")
    If cmbmodel.List.Count Then
      cmbmodel.Text = cmbmodel.List[0]
    Endif
  Endif
  $doneLst = New String[]
  $Index = 0

End

Public Sub btnrecord_Click()

  If cmbmodel.Text Then
    If btnrecord.Text = "START" Then
      btnrecord.Text = "STOP"
      btnrecord.Foreground = Color.Red
      btnclose.Enabled = False
      Wait
      StartRecording()
    Else If btnrecord.Text = "STOP" Then
      btnrecord.Text = "START"
      btnrecord.Foreground = Color.Default
      Wait
      StopRecording()
      Wait
      btnclose.Enabled = True
    Endif
  Endif

End

Public Sub btnclose_Click()

  If TextArea1.Text Then
    $sValue = TextArea1.Text
    Me.Close(True)
  Else
    Me.Close()
  Endif

End

Public Sub Timer1_Timer()

  Dim aa As Date

  aa = Date(0, 0, 0, 0, 0, 0)
  LCDLabel1.Text = Format(DateAdd(aa, gb.Second, DateDiff($start, Now(), gb.Second)), "nn : ss")

End

Private Function GetVoiceTextConversion(sPath As String)

  Dim xx As String
  Dim hForm As CGroqTrans
  Dim xindex As Integer

  If cmbmodel.Text Then
    If modBasic.$CloudAIURL_Trans And If modBasic.$CloudAIModel_Trans Then
      hForm = New CGroqTrans(modBasic.$CloudAIModel_Trans, sPath)
      xx = hForm.GetAPIAnswer()
      If xx Then
        TextArea1.Text = TextArea1.Text & Space(1) & xx
      Endif
    Else
      xindex = $Index Mod 5
      Select xindex
        Case 0
          primesTask1 = New CAudioUpload(cmbmodel.Text, sPath) As "taskEvents1"
        Case 1
          primesTask2 = New CAudioUpload(cmbmodel.Text, sPath) As "taskEvents2"
        Case 2
          primesTask3 = New CAudioUpload(cmbmodel.Text, sPath) As "taskEvents3"
        Case 3
          primesTask4 = New CAudioUpload(cmbmodel.Text, sPath) As "taskEvents4"
        Case 4
          primesTask5 = New CAudioUpload(cmbmodel.Text, sPath) As "taskEvents5"
      End Select
      $Index = $Index + 1
    Endif
  Endif

End

''--------------- Procedures -----------------
Public Sub buninstall_Click()

  modApplSub.InstallSelectedApplication(["python3-pyaudio"])

End

Public Sub Timer2_Timer()

  ListBox1.List = Dir($sFolder, "*.wav", gb.File)
  ConvertVoice()

End

Private Sub ConvertVoice()

  Dim xList As String[]
  Dim xfile As String

  xList = ListBox1.List
  xList.Sort()
  For Each xfile In xList
    If $doneLst.Exist(xfile) = False Then
      $doneLst.Add(xfile)
      GetVoiceTextConversion($sFolder &/ xfile)
    Endif
  Next

End

Private Sub StartRecording()

  Dim xcmd As String
  Dim arcmd As String[]

  If modBasic.$AudioRecMultiFiles = "Yes" Then
    $sFolder = modHelpVariable.AppCacheDir &/ modString.GetNowString()
    Mkdir $sFolder
    $start = Now()
    Timer1.Enabled = True
    Timer2.Enabled = True
    xcmd = "%run " & modHelpVariable.$pythonDirectory &/ "pyrecord.py" & Space(1) & $sFolder
    TerminalInput(xcmd)

  Else
    If System.Exist("arecord") Then
      $start = Now()
      Timer1.Enabled = True
      $sPath = Temp() & ".wav"
      arcmd = New String[]
      arcmd.Add("arecord")
      arcmd.Add("-f")
      arcmd.Add("S16_LE")
      If modBasic.$AudioRecFormat Then
        arcmd.Add("-f")
        arcmd.Add(modBasic.$AudioRecFormat)
      Endif
      arcmd.Add($sPath)
      modBasic.DebugAPIString("Execute " & arcmd.Join(Space(1)))
      $hProc = Exec arcmd
    Else
      modApplSub.InstallSelectedApplication(["alsa-utils"])
    Endif

  Endif

End

Private Sub StopRecording()

  Dim xcmd As String

  If modBasic.$AudioRecMultiFiles = "Yes" Then
    xcmd = "\x03"
    TerminalInput(xcmd)
    Timer1.Enabled = False
    Timer2.Enabled = False
    Wait 3
    Try ListBox1.List = Dir($sFolder, "*.wav", gb.File)
    If ListBox1.List.Count Then
      ConvertVoice()
    Endif

  Else
    $hProc.Kill()
    Timer1.Enabled = False
    Wait
    If Exist($sPath) Then
      Music.Load($sPath)
      GetVoiceTextConversion($sPath)
    Endif

  Endif

End

Public Sub ListBox1_Click()

  Music.Load($sFolder &/ ListBox1.Text)

End

Public Sub btnstart_Click()

  If modBasic.$AudioRecMultiFiles = "Yes" Then
    If ListBox1.Text Then
      Music.Play()
    Endif
  Else
    If Exist($sPath) Then
      Music.Play()
    Endif
  Endif

End

Public Sub btnstop_Click()

  If modBasic.$AudioRecMultiFiles = "Yes" Then
    If ListBox1.Text Then
      Music.Stop()
    Endif
  Else
    If Exist($sPath) Then
      Music.Stop()
    Endif
  Endif

End

''-------------- Python ------------------
Private Sub PressEnterKey()

  TerminalView1.Input(Chr$(10))

End

Private Sub TerminalInput(cmd As String)

  TerminalView1.Input(cmd)
  PressEnterKey()
  TerminalView1.EnsureVisible()

End

