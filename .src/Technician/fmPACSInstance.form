# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,105,64)
  Text = ("PACS Images")
  Resizable = False
  { GridView3 GridView
    MoveScaled(1,9,32,46)
    Mode = Select.Single
    Header = GridView.Horizontal
  }
  { Panel1 Panel
    MoveScaled(1,59,103,4)
    { Slider1 Slider
      MoveScaled(52,0.5,39,3.5)
      MinValue = 1
      MaxValue = 1000
      Value = 150
    }
    { btnnext Button
      MoveScaled(97,0.5,5,3.5)
      Picture = Picture["icon:/small/right"]
    }
    { btnprev Button
      MoveScaled(46,0.5,4.875,3.5)
      Picture = Picture["icon:/small/left"]
    }
    { SpinBox1 SpinBox
      MoveScaled(91,0.5,5,3.5)
      MinValue = 1
      Value = 1
    }
    { btnanalyze Button
      MoveScaled(33,0.5,11,3.5)
      Text = ("Analyze")
    }
    { cmbmodel ComboBox
      MoveScaled(0,0.5,33,3.5)
    }
  }
  { ScrollView1 ScrollView
    MoveScaled(34,1,70,58)
    { pictimage ImageView
      MoveScaled(1,1,68,56)
    }
  }
  { Panel2 Panel
    MoveScaled(13,1,20,3)
    { rbdicom RadioButton
      MoveScaled(10,0,10,3)
      Text = ("DICOM")
      Value = True
    }
    { rbimage RadioButton
      MoveScaled(0,0,10,3)
      Text = ("IMAGE")
    }
  }
  { chkanony CheckBox
    MoveScaled(1,1,11,3)
    Text = ("Anonym")
  }
  { btnexec Button
    MoveScaled(12,5,10,3)
    Text = ("View")
    Picture = Picture["icon:/small/exec"]
  }
  { btnsave Button
    MoveScaled(1,5,10,3)
    Text = ("Save")
    Picture = Picture["icon:/small/save"]
  }
  { btndowb Button
    MoveScaled(23,5,10,3)
    Text = ("Edit")
    Picture = Picture["icon:/small/edit"]
  }
  { TextBox1 TextBox
    MoveScaled(1,56,28,3)
    ReadOnly = True
  }
  { btncopy ToolButton
    MoveScaled(29,56,4,3)
    Picture = Picture["icon:/small/copy"]
  }
}
